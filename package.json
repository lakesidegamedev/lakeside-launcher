{
  "name": "lakeside-launcher",
  "private": true,
  "version": "0.3.0",
  "description": "The Lakeside Games launcher: library, store and account shell for web and native games",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
